{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steptrace:roboassem-task6:HF:visual-state-validation-v2",
  "title": "RoboAssem task 6 HF visual state validation schema v2",
  "description": "Offline validation profile derived from the Mac-supplied HF schema. The source schema file bytes were not supplied; this file is not byte-identical to that source. V2 adds exact one-left/one-right current relations. The output schema_version remains the Mac contract value 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "condition",
    "authority",
    "state_write_allowed",
    "identity_continuity",
    "current_relations",
    "historical_events",
    "history_current_applicability",
    "assumptions",
    "SOP_completion",
    "mechanical_lock",
    "force_state",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "condition": {"const": "HF"},
    "authority": {"const": "development_state_estimation_only"},
    "state_write_allowed": {"const": false},
    "identity_continuity": {"enum": ["visually_supported", "unknown", "not_observed"]},
    "current_relations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_id", "seat_id", "appearance", "evidence_input_ids", "reason"],
        "properties": {
          "part_id": {"const": "white_u_part"},
          "seat_id": {"enum": ["blue_seat_left", "blue_seat_right"]},
          "appearance": {"enum": ["visible_separation", "contact_or_alignment", "insertion_appearance", "apparent_external_position", "unknown"]},
          "evidence_input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "k04"}},
          "reason": {"type": "string"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"seat_id": {"const": "blue_seat_left"}}, "required": ["seat_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"seat_id": {"const": "blue_seat_right"}}, "required": ["seat_id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "historical_events": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_id", "seat_id", "event", "evidence_input_ids", "uncertainty"],
        "properties": {
          "part_id": {"const": "white_u_part"},
          "seat_id": {"enum": ["blue_seat_left", "blue_seat_right", "unknown"]},
          "event": {"enum": ["visible_separation", "insertion_appearance", "apparent_hold_after_release", "unknown"]},
          "evidence_input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["k01", "k02", "k03"]}},
          "uncertainty": {"type": "string"}
        }
      }
    },
    "history_current_applicability": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "SOP_completion": {"const": "unknown"},
    "mechanical_lock": {"const": "unknown"},
    "force_state": {"const": "unknown"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
